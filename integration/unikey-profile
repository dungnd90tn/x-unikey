#!/bin/sh
# Emit a short-lived context event for the x-unikey IBus engine.

set -eu
umask 077

usage() {
    echo "Usage: unikey-profile zsh on|off|probe" >&2
    exit 2
}

[ "$#" -eq 2 ] || usage
[ "$1" = zsh ] || usage
case "$2" in
    on|off|probe) state=$2 ;;
    *) usage ;;
esac

config_dir=${UNIKEY_CONFIG_DIR:-"${HOME:?HOME is not set}/.unikey"}
mkdir -p "$config_dir"
tmp=$(mktemp "$config_dir/.profile-event.XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM
printf 'profile=zsh\nstate=%s\n' "$state" > "$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$config_dir/profile-event"
trap - EXIT HUP INT TERM
